
@page "/catalogo"
@using sharpness_sharp.Components.Pages.UAComponents
@using sharpness_sharp.Data.Models
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService

<EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="AgregarCafe">
    <InputText @bind-Value="newCafe.Imagen" class="border-2 px-2" placeholder="introduce el url imagen del cafe" />
    <InputText @bind-Value="newCafe.NombreCafe" class="border-2 px-2" placeholder="introduce el nombre del cafe" />
    <InputText @bind-Value="newCafe.DescripcionCafe" class="border-2 px-2" placeholder="introduce la descripcion del cafe" />
    <InputNumber @bind-Value="@newCafe.PrecioCafe" class="border-2 px-2" placeholder="introduce el precio del cafe" />

    <button type="submit">Guardar</button>
</EditForm>

<div class="min-h-screen bg-[#f7f5f0] p-6">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
            <span class="text-sm font-bold tracking-[0.25em] uppercase text-[#66836b]">
                Coffee Experience
            </span>
            <h1 class="text-4xl md:text-5xl font-extrabold text-[#382b23] mt-3">
                Nuestro Catálogo de Café
            </h1>
            <p class="text-gray-500 mt-3 text-base">
                Descubre nuestra selección de cafés y disfruta cada momento.
            </p>
            <div class="w-16 h-1 bg-[#8b9d72] mx-auto mt-5 rounded-full"></div>
        </div>

        <div class="flex justify-between items-center mb-7">
            <h2 class="text-2xl font-bold text-[#382b23]">
                Variedades disponibles
            </h2>
            <span class="bg-[#e8eee3] text-[#557451] px-4 py-2 rounded-full text-sm font-bold">
                @lstCafes.Count cafés
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">
            @foreach (Cafe cafe in lstCafes)
            {
                <CoffeeCard Imagen="@cafe.Imagen"
                            NombreCafe="@cafe.NombreCafe"
                            DescripcionCafe="@cafe.DescripcionCafe"
                            PrecioCafe="@cafe.PrecioCafe"></CoffeeCard>
            }
        </div>

        <div class="text-center mt-12 py-6 border-t border-[#e8e1d7]">
            <p class="text-sm text-[#8a8178]">
                Coffee Experience © 2026 - Calidad y sabor en cada taza.
            </p>
        </div>
    </div>
</div>

<style>
    .cafe-card {
        transition: all 0.3s ease;
    }

    .cafe-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 15px 30px rgba(56, 43, 35, 0.12);
        border-color: #a5b69a;
    }

    .cafe-image {
        transition: transform 0.5s ease;
    }

    .cafe-card:hover .cafe-image {
        transform: scale(1.07);
    }
</style>

@code {
    private Cafe newCafe = new();
    private List<Cafe> lstCafes = new();

    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }

    private Task AgregarCafe()
    {
        return Task.CompletedTask;
    }
}
