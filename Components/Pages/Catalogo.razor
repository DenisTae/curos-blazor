@page "/catalogo"

<h3>Catálogo de Cafés</h3>

@foreach (var cafe in lstCafes)
{
    <div>
        <img src="@cafe.Imagen" width="150" />
        <h2>@cafe.NombreCafe</h2>
        <p>@cafe.DescripcionCafe</p>
        <p>@cafe.PrecioCafe Bs.</p>
    </div>
}
