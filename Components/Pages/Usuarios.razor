@page "/usuarios"

@foreach (Usuario usuario in lstUsuarios)
{
    <div>
        <div>@usuario.Nombre @usuario.Apellido</div>
        <div>Color: @usuario.ColorPiel</div>
        <div>@usuario.Email</div>
        <div>@usuario.Password</div>
        <div>@usuario.Estatura</div>
        <div>@usuario.FechaNac.ToString("yyyy-MM-dd")</div>
    </div>
}

