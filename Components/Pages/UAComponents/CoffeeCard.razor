<div class="cafe-card bg-white rounded-2xl overflow-hidden border border-[#ebe6dd] shadow-sm flex flex-col">
    <div class="relative overflow-hidden h-56">
        <img src="@imagen"
             alt="@nombreCafe"
             class="w-full h-full object-cover cafe-image" />
        <span class="absolute top-3 right-3 bg-white/95 text-[#66836b] text-xs font-bold px-4 py-2 rounded-full shadow-sm">
            ☕ Especial
        </span>
    </div>
    <div class="p-5 flex flex-col flex-grow">
        <h2 class="text-xl font-extrabold text-[#382b23] mb-3">
            @nombreCafe
        </h2>
        <p class="text-gray-500 text-sm leading-relaxed flex-grow">
            @descripcionCafe
        </p>
        <div class="flex justify-between items-center mt-5 pt-4 border-t border-[#eeeae3]">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                Precio
            </span>
            <span class="bg-[#edf3e9] text-[#52734f] font-extrabold text-lg px-4 py-2 rounded-xl">
                Bs. @precioCafe
            </span>
        </div>
    </div>
</div>
@code{
    [Parameter] public string? imagen { get; set; } 
    [Parameter] public string? nombreCafe { get; set; }
    [Parameter] public string? descripcionCafe { get; set; }
    [Parameter] public decimal? precioCafe { get; set; }


}